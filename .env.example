# Copy to .env and fill in real values. Vite only exposes variables prefixed with VITE_.
# Your live address, e.g. https://yourdomain.com. Leave empty to use the address the site is opened on.
VITE_SITE_URL=

# Supabase (frontend). Leave empty to run on the built-in mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-side only: seeding, admin scripts). NEVER expose in the browser or commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tracking (leave empty to disable; events still flow to window.dataLayer, the dev console and the events table)
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_GA_ID=
VITE_GTM_ID=
VITE_ANALYTICS_DEBUG=false

# Payments
VITE_ONLINE_PAYMENTS=false
VITE_PAYMENT_PROVIDER=
